# PostgreSQL connection. Keep ?schema=app (or &schema=app) so the tables live in their own schema.
#   local (npm run db:up):  postgresql://dev360:dev360pass@localhost:5433/dev360?schema=app
#   Neon:                   postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require&schema=app
DATABASE_URL=postgresql://dev360:dev360pass@localhost:5433/dev360?schema=app

# Only for scripts/migrate-legacy.ts: the OLD app's database (tables d360_docs, d360_users, d360_blobs).
LEGACY_DATABASE_URL=

# Long random string used to sign sign-in cookies. REQUIRED in production.
# Use the same value as the old deployment so people stay signed in after the switch.
#   generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Who may create their own account (the very first account is always allowed and becomes the owner/admin).
# Option A: only these email domains may self-register (they start as Viewer)
ALLOWED_EMAIL_DOMAIN=eramengineering.com, eramhcm.com
# Option B: anyone may self-register (true/false). Default false: admins create accounts.
ALLOW_SIGNUP=false

# Each account's own role is used (new accounts are Admin). true = treat every account as Admin.
OPEN_ACCESS=false

APP_NAME=Dev 360 Tracker
# Link to the tracker used in WhatsApp / email messages (can also be set in Admin panel → Notifications)
APP_URL=https://your-tracker.vercel.app
# Largest attachment in MB (Vercel limits request bodies to about 4.5 MB)
MAX_UPLOAD_MB=20

# Temporary password for the accounts in seed/accounts.json (npm run db:seed).
# Leave empty to generate a random one per account, printed in the terminal.
SEED_PASSWORD=
